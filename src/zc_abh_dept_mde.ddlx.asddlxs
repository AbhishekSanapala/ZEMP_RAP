@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'Department',
  typeNamePlural: 'Departments',
  title: {
    type: #STANDARD,
    value: 'DepartmentName'
  },
  description: {
    type: #STANDARD,
    value: 'DepartmentId'
  }
}

annotate view ZC_ABH_DEPT with
{
  @UI.facet: [
    {
      id: 'DepartmentDetails',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Department Details',
      position: 10
    },
    {
      id: 'Employees',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Employees',
      position: 20,
      targetElement: '_Employee'
    }
  ]

  @UI.lineItem: [
    {
      position: 10,
      importance: #HIGH,
      label: 'Department ID'
    }
  ]
  @UI.selectionField: [
    {
      position: 10
    }
  ]
  @UI.identification: [
    {
      position: 10,
      label: 'Department ID'
    }
  ]
  DepartmentId;

  @UI.lineItem: [
    {
      position: 20,
      importance: #HIGH,
      label: 'Department Name'
    }
  ]
  @UI.selectionField: [
    {
      position: 20
    }
  ]
  @UI.identification: [
    {
      position: 20,
      label: 'Department Name'
    }
  ]
  DepartmentName;

  @UI.lineItem: [
    {
      position: 30,
      importance: #HIGH,
      label: 'Location'
    }
  ]
  @UI.selectionField: [
    {
      position: 30
    }
  ]
  @UI.identification: [
    {
      position: 30,
      label: 'Location'
    }
  ]
  Location;

  @UI.hidden: true
  CreatedBy;

  @UI.hidden: true
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;
}