projection;
strict ( 2 );
use draft;

define behavior for ZC_ABH_DEPT alias Department
use etag
{
  use create;
  use update;
  use delete;

  use association _Employee { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZC_ABH_EMP alias Employee
use etag
{
  use update;
  use delete;

  use association _Department { with draft; }
}